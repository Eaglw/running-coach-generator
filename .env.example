# Directory Paths (defaults suitable for local execution or Docker container)
DATA_DIR=./data
MUSIC_DIR=./data/music
CACHE_DIR=./data/cache
PODCAST_DIR=./data/podcasts
TEMP_DIR=./data/temp

# Base URL used for podcast feed enclosure links (accessible by Apple Podcasts / Apple Watch)
# e.g., http://192.168.1.100:8000 or https://coach.yourdomain.com
BASE_URL=http://localhost:8000

# Podcast Channel Metadata
PODCAST_TITLE=Running Coach Daily
PODCAST_DESCRIPTION=Personalized AI-guided running workouts synced to your music and Apple Podcasts
PODCAST_AUTHOR=AI Running Coach
PODCAST_LANGUAGE=it-IT
PODCAST_IMAGE_URL=http://localhost:8000/podcast/cover.jpg

# LLM Configuration (OpenAI-compatible: Gemini, OpenAI, Ollama, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# TTS Engine Configuration ("piper" or "kokoro")
TTS_ENGINE=piper
TTS_VOICE=it_IT-riccardo-x_low
